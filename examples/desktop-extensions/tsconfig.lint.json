{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@rsi-agent-pi/extension-ui": ["../../packages/extension-ui/src/index.ts"],
      "@rsi-agent-pi/extension-ui/browser": ["../../packages/extension-ui/src/browser.ts"]
    }
  },
  "include": ["*/**/*.ts", "*/**/*.mts"],
  "exclude": ["**/node_modules", "**/dist"]
}
